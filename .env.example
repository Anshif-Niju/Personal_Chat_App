# REST base URL. Keep "/api" in production: vercel.json rewrites /api/* to the Render backend,
# which makes the refresh-token cookie first-party.
VITE_API_URL=/api

# Socket.IO server URL. Empty in development (Vite proxies /socket.io).
# In production set it to the Render backend URL, e.g. https://privatechat-api.onrender.com
VITE_SOCKET_URL=
